{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "64rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#14161a",
					"name": "Contrast"
				},
				{
					"slug": "muted",
					"color": "#5b6270",
					"name": "Muted"
				},
				{
					"slug": "accent",
					"color": "#1c5d3a",
					"name": "Accent"
				},
				{
					"slug": "surface",
					"color": "#f5f4f1",
					"name": "Surface"
				},
				{
					"slug": "line",
					"color": "#e2e0da",
					"name": "Line"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/Inter-VariableFont.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/Inter-Italic-VariableFont.woff2"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Newsreader",
					"fontFamily": "Newsreader, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader/Newsreader-VariableFont.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader/Newsreader-Italic-VariableFont.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "4",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "5",
					"size": "4rem"
				},
				{
					"slug": "70",
					"name": "6",
					"size": "6rem"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--contrast)",
						"offset": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "3px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "4px"
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page, wide (no sidebar)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-no-title",
			"title": "Page, no title (landing)",
			"postTypes": [
				"page"
			]
		}
	]
}
